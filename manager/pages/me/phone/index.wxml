<view class="base-stack">
  <view class="base-card">
    <text class="card-title">登录手机号</text>
    <view class="field-block">
      <text class="field-label">当前手机号</text>
      <text class="describe-text">{{currentPhone || '未设置'}}</text>
    </view>
    <text class="describe-text">为保障账号安全，登录手机号不支持在应用内自助修改。如需变更，请由服务人员核实店主身份后办理。</text>
  </view>

  <view class="base-card">
    <text class="card-title">联系服务人员</text>
    <view class="row-space-between" style="margin-top:16rpx;" bindtap="handleCallSupport">
      <text class="card-little-title">如需变更登录手机号，请联系服务人员</text>
      <text class="card-button">拨打电话</text>
    </view>
  </view>
</view>
