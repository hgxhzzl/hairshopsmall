<view class="base-stack">
  <view class="base-card">
    <view  class="card-title">消费业务设置</view >
    <view  class="card-little-title">设置新增消费页展示哪些业务类型</view>
    <view  class="describe-text">已启用类型：<text class="describe-strong">{{enabledCount}}</text></view>

    <view wx:for="{{payTypes}}" wx:key="key" class="field-block {{index === 0 ? '' : 'border-top'}}">
      <text class="field-label">{{item.label}}</text>
      <view class="row-space-between">
        <text class="describe-text">{{item.description}}</text>
        <view class="field-settings-toggle-group">
          <text class="field-settings-toggle-btn {{!fieldVisibility[item.key] ? 'field-settings-toggle-btn-active' : ''}}" bindtap="onVisibilityChange" data-key="{{item.key}}" data-visible="{{false}}">否</text>
          <text class="field-settings-toggle-btn {{fieldVisibility[item.key] ? 'field-settings-toggle-btn-active' : ''}}" bindtap="onVisibilityChange" data-key="{{item.key}}" data-visible="{{true}}">是</text>
        </view>
      </view>
    </view>
  </view>

  <view class="base-card">
    <view class="card-title">使用价格设置</view>
    <view class="card-little-title">为每种消费业务指定使用原价或会员价</view>

    <view wx:for="{{payTypes}}" wx:key="key" class="field-block {{index === 0 ? '' : 'border-top'}}">
      <text class="field-label">{{item.label}}</text>
      <view class="row-space-between">
        <text class="describe-text">使用哪一种价格进行计算</text>
        <view class="field-settings-toggle-group">
          <text wx:for="{{priceOptions}}" wx:key="key" wx:for-item="option" class="field-settings-toggle-btn {{usagePrice[item.key] === option.key ? 'field-settings-toggle-btn-active' : ''}}" bindtap="onPriceChange" data-pay-type="{{item.key}}" data-price-key="{{option.key}}">{{option.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <text wx:if="{{actionError}}" class="error-text">{{actionError}}</text>

  <button class="submit-button" bindtap="handleSave" disabled="{{!canSubmit || isSaving}}">
    {{isSaving ? '保存中...' : '保存设置'}}
  </button>
</view>
