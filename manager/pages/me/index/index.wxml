<view class="page-wrapper" style="position:relative;">
  <scroll-view scroll-y class="page-scroll" style="height:calc(100vh - 16rpx);padding-bottom:280rpx;">
  <view class="base-card">
    <view class="row-space-between">
      <text class="card-title" style="padding-bottom:0;">{{shop.shopName || '未命名店铺'}}</text>
    </view>
    <view class="card-little-title">店主：{{shop.ownerName || '未填写'}}</view>
    <view class="card-little-title">地址：{{shop.address || '地址未填写'}}</view>
    <view class="card-little-title">电话：{{shop.phoneNumber || ''}}</view>
    <view class="card-little-title">注册：{{shop.registerTime || '暂无数据'}}</view>

   
  </view>

    <view class="base-card">
    
      <text class="describe-text">服务截止日期</text>
      <text class="describe-strong" style="display:block;margin-top:4rpx;">{{shop.expireTime || '暂无数据'}}</text>
      <text class="describe-text" style="display:block;margin-top:8rpx;">{{expireHintText}}</text>
    

     </view>

  <view class="base-card">
    <text class="card-title">快捷操作</text>
    <view style="display:flex;flex-direction:column;gap:16rpx;">
      <view class="row-space-between" style="gap:16rpx;">
        <view class="quick-action-card" bindtap="navToShopEdit" style="flex:1;background: #f1dbbb;">
          <text class="quick-action-label">店铺资料</text>
          <text class="describe-text">更新店铺基础资料</text>
        </view>
        <view class="quick-action-card" bindtap="navToPhone" style="flex:1;background: #d8ebdf;">
          <text class="quick-action-label">手机号码</text>
          <text class="describe-text">{{shop.phoneNumber || ''}}</text>
        </view>
      </view>
      <view class="row-space-between" style="gap:16rpx;">
        <view class="quick-action-card" bindtap="navToPassword" style="flex:1;background: #f5f0d9;">
          <text class="quick-action-label">账户安全</text>
          <text class="describe-text">定期更新登录密码</text>
        </view>
        <view class="quick-action-card" bindtap="navToServiceSettings" style="flex:1;background: #c8e1fc;">
          <text class="quick-action-label">服务设置</text>
          <text class="describe-text">管理服务项目与设置</text>
        </view>
      </view>
      <view class="row-space-between" style="gap:16rpx;">
        <view class="quick-action-card" bindtap="navToMemberFieldSettings" style="flex:1;background: #f1dbbb;">
          <text class="quick-action-label">会员字段设置</text>
          <text class="describe-text">管理会员资料显示</text>
        </view>
        <view class="quick-action-card" bindtap="navToPayTypeSettings" style="flex:1;background: #d8ebdf;">
          <text class="quick-action-label">消费类型设置</text>
          <text class="describe-text">管理消费记账类型</text>
        </view>
      </view>
    </view>
  </view>

  <view class="base-card">
    <view class="card-title">我的账本</view>
    <view class="ledger-server">
      <view class="describe-text">账本起止日期</view>
      <view class="card-little-title">{{accountBookDateRange || '生成后可查看账本'}}</view>
      <view wx:if="{{accountBook.bookName}}" class="card-little-title">{{accountBook.bookName}}</view>
      <view wx:if="{{actionError}}" class="error-text">{{actionError}}</view>
      <view wx:if="{{actionMessage}}" class="muted-text">{{actionMessage}}</view>
      <view class="me-ledger-actions">
        <view class="card-button" bindtap="handleViewAccountBook">查看账本</view>
        <view class="card-button" bindtap="handleGenerateAccountBook">{{isGenerating ? '生成中...' : '生成账本'}}</view>
      </view>
    </view>
  </view>

  <view class="base-card">
    <text class="card-title">联系客服</text>
    <text class="describe-text" style="display:block;margin-top:8rpx;">使用中遇到问题，可致电服务人员。</text>
    <view class="row-space-between" style="margin-top:16rpx;" bindtap="handleCallSupport">
      <text class="card-little-title">{{supportPhone}}</text>
      <text class="card-button">拨打电话</text>
    </view>
    <view class="row-space-between" style="margin-top:16rpx;">
      <text class="card-little-title">账号注销</text>
      <text class="card-button" bindtap="handleCancelAccount">申请注销</text>
    </view>
    <text class="describe-text" style="display:block;margin-top:12rpx;">注销申请可在应用内提交与撤回；受理后 3 个工作日内联系确认身份，确认后 7 个工作日内完成数据删除。</text>
    <view style="display:flex;gap:24rpx;margin-top:20rpx;">
      <text class="agreement-link" bindtap="navToServiceAgreement">《服务协议》</text>
      <text class="agreement-link" bindtap="navToPrivacyPolicy">《隐私政策》</text>
    </view>
  </view>
</scroll-view>

  <view style="position:absolute;bottom:156rpx;left:8rpx;right:8rpx;padding:0 16rpx 16rpx;">
    <button class="exit-button" bindtap="handleLogout">退出登录</button>
  </view>
</view>
