<view class="base-stack">
  <!-- 方式一：短信自助重置（推荐） -->
  <view class="base-card">
    <text class="card-title">短信自助重置</text>
    <text class="describe-text" style="display:block;margin-top:8rpx;">通过注册手机号接收验证码，验证后可直接设置新密码。</text>

    <view class="field-block" style="margin-top:24rpx;">
      <text class="field-label">注册手机号</text>
      <input class="field-info" type="number" maxlength="11" value="{{phoneNumber}}" bindinput="onPhoneInput" placeholder="请输入注册时使用的手机号" />
    </view>

    <view class="field-block border-top">
      <text class="field-label">短信验证码</text>
      <view class="code-row">
        <input class="field-info code-input" type="number" maxlength="6" value="{{smsCode}}" bindinput="onSmsCodeInput" placeholder="6 位验证码" />
        <text class="code-send-btn{{smsCooldown > 0 ? ' code-disabled' : ''}}" bindtap="handleSendSmsCode">{{smsCooldown > 0 ? smsCooldown + 's 后重发' : '获取验证码'}}</text>
      </view>
    </view>

    <view class="field-block border-top">
      <text class="field-label">新密码</text>
      <input class="field-info" type="password" value="{{newPassword}}" bindinput="onNewPasswordInput" placeholder="6位以上新密码" />
    </view>

    <view class="field-block border-top">
      <text class="field-label">确认新密码</text>
      <input class="field-info" type="password" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" placeholder="请再次输入新密码" />
    </view>
  </view>

  <text wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</text>

  <button class="submit-button" style="margin-bottom: 10rpx;" bindtap="handleSubmit" disabled="{{!canSubmit || isSubmitting}}">
    {{isSubmitting ? '重置中...' : '确认重置'}}
  </button>

  <!-- 方式二：联系服务人员（兜底） -->
  <view class="base-card">
    <text class="card-title">联系客服</text>
    <text class="describe-text" style="display:block;margin-top:8rpx;">手机号已停用或收不到验证码？可致电服务人员人工办理，致电时请提供注册手机号与店铺名称，便于核对身份。</text>
    <view class="row-space-between" style="margin-top:16rpx;align-items:center;" bindtap="handleCallSupport">
      <text class="describe-text">{{supportPhone}}</text>
      <text class="card-button">拨打电话</text>
    </view>
  </view>

  <view style="display:flex;justify-content:center;margin-top:16rpx;">
    <text style="color:#6f8197;font-size:28rpx;" bindtap="goLogin">返回登录</text>
  </view>
</view>
