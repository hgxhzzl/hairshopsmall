<view class="base-stack" style="padding:10rpx 75rpx;">
  <!-- 品牌区 -->
  <view style="display:flex;flex-direction:column;align-items:center;padding:100rpx 0 48rpx;">
    <text style="font-size:72rpx;font-weight:800; color:#245c98;letter-spacing:0.08em;">易顺通</text>
    <text style="font-size:28rpx;color:#6f8197;margin-top:12rpx;">美发店会员管理</text>
  </view>

  <!-- 登录表单卡片 -->
 
    <!-- 手机号 -->
    <view style="display:flex;align-items:center;padding:22rpx 0;border-bottom:1px solid #eef1f5;">
      <t-icon name="mobile" size="44rpx" color="#245c98" style="margin-right:20rpx;flex-shrink:0;" />
      <input style="flex:1;border:none;font-size:30rpx;color:#333;" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号码" placeholder-style="color:#b0b8c1;font-size:30rpx;" />
    </view>

    <!-- 密码 -->
    <view style="display:flex;align-items:center;padding:22rpx 0;border-bottom:1px solid #eef1f5;">
      <t-icon name="lock-on" size="44rpx" color="#245c98" style="margin-right:20rpx;flex-shrink:0;" />
      <input style="flex:1;border:none;font-size:30rpx;color:#333;" type="password" value="{{password}}" bindinput="onPasswordInput" placeholder="请输入登录密码" placeholder-style="color:#b0b8c1;font-size:30rpx;" />
    </view>
 
 <text wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</text>
     <button class="submit-button" style="margin-bottom: 10rpx;"bindtap="handleSubmit" disabled="{{!canSubmit || isSubmitting}}">
    {{isSubmitting ? '登录中...' : '登 录'}}
  </button>

  <view style="display:flex;justify-content:space-between;">
    <text style="color:#245c98;font-size:28rpx;" bindtap="goRegister">用户注册</text>
    <text style="color:#245c98;font-size:28rpx;" bindtap="goForgotPassword">忘记密码</text>
  </view>
</view>