<wxs module="fmt" src="/utils/filters.wxs" />
<view class="page-wrapper">
  <view class="query-header">
  <view class="base-card">
    <view class="row-space-between">
      <text class="card-title">会员查询</text>
    </view>
    <view class="query-input-field">
      <t-icon name="search" size="36rpx" color="#99a5b5" />
      <input
        class="query-input-control"
        bindinput="onSearchInput"
        placeholder="输入姓名/编号/手机号"
        value="{{searchText}}"
      />
      <t-icon
        wx:if="{{searchText}}"
        name="close" size="36rpx" color="#99a5b5"
        bindtap="clearSearch"
      />
    </view>
    <view class="describe-wrap">
      <text class="describe-text">会员：<text class="describe-strong">{{filteredStats.totalCount}}</text> 人</text>
      <text class="describe-text">账户总额：<text class="describe-strong">{{fmt.money(filteredStats.totalBalance)}}</text> 套餐总额：<text class="describe-strong">{{fmt.money(filteredStats.totalPrepaid)}}</text></text>
    </view>
  </view>
  </view>
  <!--<scroll-view scroll-y class="page-scroll"> -->
  <scroll-view scroll-y class="page-scroll" style="height:calc(100vh - 190rpx);">
  <view wx:if="{{memberError}}" class="empty-state-card"><text class="error-text">{{memberError}}</text></view>

  <block wx:elif="{{filteredMembers.length > 0}}">
    <view>
      <view class="base-card" wx:for="{{filteredMembers}}" wx:key="id">
        <view class="list-card-head">
          <view class="list-card-avatar-wrap" bindtap="onOpenMemberDetail" data-id="{{item.id}}">
            <initial-badge value="{{item.name}}" fallback="会" gender="{{item.gender}}" size="md" />
          </view>
          <view class="list-card-content">
            <view class="row-space-between">
              <text class="list-card-title">{{item.name || '未命名会员'}}</text>
              <text class="member-gender-pill {{item.gender === '女' ? 'member-gender-pill-female' : 'tone-info-soft'}}">{{item.gender || '-'}}</text>
            </view>
            <view class="row-space-between list-card-info-row">
              <view class="list-card-metric">
                <text>账户余额</text>
                <text class="list-card-amount">{{fmt.money(item.balance)}}</text>
              </view>
              <text class="list-card-metric list-card-meta"># {{item.memberNo || '未设'}}</text>
            </view>
            <view class="row-space-between list-card-info-row">
              <view class="list-card-metric">
                <text>套餐余额</text>
                <text class="list-card-amount">{{fmt.money(item.prepaid)}}</text>
              </view>
              <text class="list-card-metric list-card-meta">☏ {{item.phone || '未填写'}}</text>
            </view>
          </view>
        </view>
        <view class="list-card-actions">
          <action-btn type="detail" bind:tap="onOpenMemberDetail" data-id="{{item.id}}" />
          <action-btn type="select" bind:tap="onSelectMember" data-id="{{item.id}}" data-name="{{item.name}}" />
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{isMemberLoading}}">
    <view class="empty-state-card"><text class="empty-state-text">正在读取会员列表...</text></view>
  </block>

  <block wx:else>
    <view class="empty-state-card">
      <text class="empty-state-title">{{searchText ? '暂无匹配会员' : '暂无会员'}}</text>
      <text class="empty-state-text"><block wx:if="{{searchText}}">当前搜索条件为"{{searchText}}"，没有匹配的会员。</block><block wx:else>还没有添加任何会员。</block></text>
    </view>
  </block>
</scroll-view>
</view>
