.tab-bar {
  display: flex; align-items: center; justify-content: space-around;
  height: 170rpx; padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff; border-top: 1rpx solid #e7ecf2;
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 999;
}
.tab-bar-item {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  flex: 1; height: 100%;
}
.tab-bar-icon-wrap {
  display: flex; align-items: center; justify-content: center;margin-top: 6px;
}
.tab-bar-text { font-size: 24rpx; color: #666666; margin-top: 4px; line-height: 1; }
.tab-bar-text-active { color: #245c98; font-weight: 600; }
